# Host directory that holds all managed data. Bind-mounted to /data in containers.
# On macOS this path MUST be added to Docker Desktop > Settings > Resources > File Sharing.
BIOINFO_HOME=/Volumes/ModelExtension/BioinfoHelper

# Infrastructure
MONGO_URL=mongodb://mongo:27017/biopipe?replicaSet=rs0&directConnection=true
REDIS_URL=redis://redis:6379/0

# Paths that register-in-place is allowed to reference (colon-separated).
BIOINFO_REGISTER_ROOTS=/data

# Worker tuning
WORKER_REPLICAS=2
WORKER_MAX_CONCURRENT=4
LEASE_TTL_SECONDS=30

# Phase 0 simple-upload ceiling (bytes). Chunked uploads arrive in Phase 2.
MAX_SIMPLE_UPLOAD_BYTES=104857600

# Load governor (Phase 4). Overrides for cgroup detection inside the Docker VM.
BIOINFO_CPU_BUDGET=
BIOINFO_MEM_BUDGET_MB=

# Look up SRR/SRX accessions at NCBI during ingest (outbound network call).
SRA_ENRICHMENT_ENABLED=true

# Where the SRA Toolkit keeps its configuration and download cache. Set in
# docker-compose.yml; override only if BIOINFO_HOME is not mounted at /data.
# Downloading a run also writes its cache under this directory, so it needs
# room for the runs being fetched -- not just a settings file.
# NCBI_SETTINGS=/data/tmp/ncbi/user-settings.mkfg

LOG_LEVEL=INFO
