# Host directory that holds all managed data. Bind-mounted to /data in containers.
# On macOS this path MUST be added to Docker Desktop > Settings > Resources > File Sharing.
BIOINFO_HOME=

# Port the web UI is published on (host side).
WEB_PORT=5173

# Port the API is published on (host side).
API_PORT=8000

# Which host interface the published ports bind to. Covers the web UI, the
# API, AND the Mongo (27017) and Redis (6379) publishes. Defaults to
# loopback: only this machine can reach BioFlow. Setting this to 0.0.0.0
# exposes the stack -- including the unauthenticated database -- to every
# device on the network with nothing in front of it. A child node needs
# 0.0.0.0 (it connects back over the network); a single-machine install
# should leave it at 127.0.0.1.
BIND_ADDRESS=127.0.0.1

# Image tag to run. Leave at latest; set to a specific tag only to pin a
# version for debugging.
BIOFLOW_TAG=latest

# Infrastructure
MONGO_URL=mongodb://mongo:27017/biopipe?replicaSet=rs0&directConnection=true
REDIS_URL=redis://redis:6379/0

# Paths that register-in-place is allowed to reference (colon-separated).
BIOINFO_REGISTER_ROOTS=/data

# Worker tuning
WORKER_REPLICAS=2
WORKER_MAX_CONCURRENT=4
LEASE_TTL_SECONDS=30

# Phase 0 simple-upload ceiling (bytes). Chunked uploads arrive in Phase 2.
MAX_SIMPLE_UPLOAD_BYTES=104857600

# Load governor (Phase 4). Overrides for cgroup detection inside the Docker VM.
BIOINFO_CPU_BUDGET=
BIOINFO_MEM_BUDGET_MB=

# Look up SRR/SRX accessions at NCBI during ingest (outbound network call).
SRA_ENRICHMENT_ENABLED=true

# Feedback notifications: when FEEDBACK_ENABLED=true and FEEDBACK_WEBHOOK_URL is
# set, new submissions from the Help > Feedback page are pushed to the webhook
# (Discord-compatible). Delivery is best-effort -- failures are logged but never
# affect the API response or lose the saved feedback.
FEEDBACK_ENABLED=true
FEEDBACK_WEBHOOK_URL=

LOG_LEVEL=INFO

# Where the SRA Toolkit keeps its configuration and download cache. Set in
# docker-compose.yml; override only if BIOINFO_HOME is not mounted at /data.
# Downloading a run also writes its cache under this directory, so it needs
# room for the runs being fetched -- not just a settings file.
# NCBI_SETTINGS=/data/tmp/ncbi/user-settings.mkfg

LOG_LEVEL=INFO
