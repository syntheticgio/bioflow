# Dedicated Dockerfile for CI runner (used by GitHub Actions build-check.yml)
# Contains all pre-installed system toolchains, Python packages, and bioinfo binaries
# to make backend test jobs run in ~10 seconds without apt/curl downloads.

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /srv

# 1. System dependencies and bioinformatics CLI packages
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        zlib1g-dev \
        libhts-dev \
        curl \
        ca-certificates \
        git \
        bzip2 \
        shellcheck \
        # The Docker *client* only -- no daemon. backend-full-test mounts the
        # host's socket and starts its Mongo replica set with `docker run`,
        # which it must do rather than using `services:` because a service
        # container takes no `command:` and so cannot be given --replSet.
        # Without this the job fails instantly with "docker: command not
        # found" (2026-08-19). `docker-cli`, not `docker.io`: the latter is
        # the full engine and ships no /usr/bin/docker on this base.
        docker-cli \
        # `ps`, for tests/queue/test_subprocess.py's _pid_alive: it
        # distinguishes a live process from an unreaped zombie. Without it
        # that helper's `except OSError` treats every zombie as alive, and
        # the process-group cancellation tests fail claiming the group was
        # never signalled when it was. Bites in a job container specifically,
        # where PID 1 is the job's shell and does not reap orphans the way a
        # real init does.
        procps \
        # npm, for ops/tests/test_release_preflight.py: release.sh bumps the
        # launcher's package.json through `npm version`, and seven of those
        # tests drive it for real. A GitHub runner has npm preinstalled, so
        # this only became a requirement once the job moved into a container.
        npm \
        minimap2 \
        samtools \
        tabix \
        flye \
        fastp \
        bcftools \
        bowtie2 \
        hisat2 \
        sra-toolkit \
    && rm -rf /var/lib/apt/lists/*

# 2. NCBI Datasets CLI
RUN curl -fsSL --retry 3 --retry-connrefused --max-time 120 \
      "https://ftp.ncbi.nlm.nih.gov/pub/datasets/command-line/v2/linux-amd64/datasets" \
      -o /usr/local/bin/datasets \
    && chmod +x /usr/local/bin/datasets \
    && datasets --version

# 3. /bin/sh -> bash symlink (align_runner needs pipefail)
RUN ln -sf bash /bin/sh \
    && /bin/sh -o pipefail -c 'true | true'

# 4. bwa-mem2 x86-64 prebuilt release bundle
ARG BWA_MEM2_VERSION=2.2.1
RUN curl -fsSL --retry 3 --retry-connrefused --max-time 180 \
      "https://github.com/bwa-mem2/bwa-mem2/releases/download/v${BWA_MEM2_VERSION}/bwa-mem2-${BWA_MEM2_VERSION}_x64-linux.tar.bz2" \
      | tar -xj -C /opt \
    && printf '#!/bin/sh\nexec "/opt/bwa-mem2-%s_x64-linux/bwa-mem2" "$@"\n' "${BWA_MEM2_VERSION}" \
       > /usr/local/bin/bwa-mem2 \
    && chmod +x /usr/local/bin/bwa-mem2 \
    && (bwa-mem2 version || true)

# 5. Pre-setup data directories
RUN mkdir -p /data/.biopipe /data/objects /data/staging /data/tmp \
    && echo "biopipe-home-v1" > /data/.biopipe/VERSION \
    && chmod -R 777 /data

# 6. The backend's Python dependencies, pre-installed.
#
# Only pyproject.toml is copied, and the app itself is deliberately NOT
# installed: what gets baked in is the dependency set, which changes rarely,
# while the source changes every commit. Each job still runs
# `pip install -e backend/.[dev]` against its own checkout -- that step then
# finds every requirement already satisfied and only has to link the package,
# turning ~17s of downloading into about a second.
#
# The consequence to know about: this layer goes stale when pyproject.toml
# gains a dependency, and ci-runner.yml does not rebuild on that. Nothing
# breaks when it does -- the job's own pip install fetches whatever is
# missing, exactly as it does today, just more slowly until the image is
# rebuilt. Add `backend/pyproject.toml` to that workflow's `paths:` if the
# rebuild should follow the dependency automatically.
COPY backend/pyproject.toml /tmp/backend/pyproject.toml
RUN cd /tmp/backend \
    && mkdir -p app && touch app/__init__.py \
    && pip install --no-cache-dir '.[dev]' \
    && pip uninstall -y biopipe-backend \
    && rm -rf /tmp/backend
