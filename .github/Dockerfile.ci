# Dedicated Dockerfile for CI runner (used by GitHub Actions build-check.yml)
# Contains all pre-installed system toolchains, Python packages, and bioinfo binaries
# to make backend test jobs run in ~10 seconds without apt/curl downloads.

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /srv

# 1. System dependencies and bioinformatics CLI packages
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        zlib1g-dev \
        libhts-dev \
        curl \
        ca-certificates \
        git \
        bzip2 \
        shellcheck \
        minimap2 \
        samtools \
        tabix \
        flye \
        fastp \
        bcftools \
        bowtie2 \
        hisat2 \
        sra-toolkit \
    && rm -rf /var/lib/apt/lists/*

# 2. NCBI Datasets CLI
RUN curl -fsSL --retry 3 --retry-connrefused --max-time 120 \
      "https://ftp.ncbi.nlm.nih.gov/pub/datasets/command-line/v2/linux-amd64/datasets" \
      -o /usr/local/bin/datasets \
    && chmod +x /usr/local/bin/datasets \
    && datasets --version

# 3. /bin/sh -> bash symlink (align_runner needs pipefail)
RUN ln -sf bash /bin/sh \
    && /bin/sh -o pipefail -c 'true | true'

# 4. bwa-mem2 x86-64 prebuilt release bundle
ARG BWA_MEM2_VERSION=2.2.1
RUN curl -fsSL --retry 3 --retry-connrefused --max-time 180 \
      "https://github.com/bwa-mem2/bwa-mem2/releases/download/v${BWA_MEM2_VERSION}/bwa-mem2-${BWA_MEM2_VERSION}_x64-linux.tar.bz2" \
      | tar -xj -C /opt \
    && printf '#!/bin/sh\nexec "/opt/bwa-mem2-%s_x64-linux/bwa-mem2" "$@"\n' "${BWA_MEM2_VERSION}" \
       > /usr/local/bin/bwa-mem2 \
    && chmod +x /usr/local/bin/bwa-mem2 \
    && (bwa-mem2 version || true)

# 5. Pre-setup data directories
RUN mkdir -p /data/.biopipe /data/objects /data/staging /data/tmp \
    && echo "biopipe-home-v1" > /data/.biopipe/VERSION \
    && chmod -R 777 /data
