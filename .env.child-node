# BioFlow child node — copy to .env and fill in the values.
#
# The child node connects to the PRIMARY machine's Redis and Mongo.
# No local database containers are started.

# Primary node's IP or hostname.  The primary's docker-compose.yml already
# exposes 27017 and 6379 on 0.0.0.0, so these should be reachable.
MONGO_URL=mongodb://<primary-ip>:27017/biopipe?replicaSet=rs0&directConnection=true
REDIS_URL=redis://<primary-ip>:6379/0

# A stable name for this physical machine, shown in the Nodes settings page.
WORKER_NODE_ID=child-laptop

# "compute" tells the worker it is a compute node (triggers blob transfer).
NODE_TYPE=compute

# The primary's HTTP API — the child fetches input blobs, pushes outputs,
# enrolls, and polls revocation status here.  Must match the primary's
# externally-routable address.
PRIMARY_API_URL=http://<primary-ip>:8000

# Shared enrollment key — must match the primary's ENROLLMENT_KEY.
# Leave empty if the primary has no key set (open enrollment).
ENROLLMENT_KEY=

# Optional: shared secret for blob-transfer authentication.
# Must match NODE_SHARED_SECRET on the primary.  Leave empty to skip auth.
NODE_SHARED_SECRET=
# Scratch space for temporary files during computation.
# Defaults to ./data relative to this directory.
BIOINFO_HOME=/data/scratch

# Optional: maximum concurrent jobs (default: 4).
# WORKER_MAX_CONCURRENT=4

# Optional: hard memory ceiling in bytes (default: 0 = unlimited).
# BIOFLOW_HARD_MEM_LIMIT=0
